# =============================================================================
# docker-mailserver configuration
# =============================================================================
# Copy to mailserver.env and adjust. Full reference:
#   https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
# Tuned for a small 1 vCPU / 2 GB VPS: ClamAV OFF (it alone needs ~1 GB RAM).
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Account/alias storage. FILE = flat files managed by `setup email add` (simple,
# no external DB). DKIM keys are auto-generated per mail domain with FILE.
ACCOUNT_PROVISIONER=FILE

# Log level: info while setting up, then lower to warn/error.
LOG_LEVEL=info

# Timezone
TZ=UTC

# -----------------------------------------------------------------------------
# TLS
# -----------------------------------------------------------------------------
# letsencrypt = read certs from /etc/letsencrypt/live/<hostname>/ (mounted
# read-only from the web stack's certbot volume). You MUST issue a cert for
# mail.simorghai.com first (see README) or the container will fall back/err.
SSL_TYPE=letsencrypt
# If your cert's directory name differs from the container hostname, set it:
# SSL_DOMAIN=mail.simorghai.com

# -----------------------------------------------------------------------------
# Anti-spam / anti-virus  (kept lean for 2 GB RAM)
# -----------------------------------------------------------------------------
ENABLE_CLAMAV=0          # OFF: ClamAV needs ~1 GB RAM on its own
ENABLE_AMAVIS=1          # mail filtering glue (lightweight without ClamAV)
ENABLE_SPAMASSASSIN=1    # rule-based spam scoring
SPAMASSASSIN_SPAM_TO_INBOX=1
ENABLE_POSTGREY=0        # greylisting off (can delay first mail; enable later)

# Rspamd is a heavier all-in-one alternative; leave OFF on a 2 GB box.
ENABLE_RSPAMD=0

# -----------------------------------------------------------------------------
# DKIM (OpenDKIM is the default signer; keys generated via `setup config dkim`)
# -----------------------------------------------------------------------------
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1

# -----------------------------------------------------------------------------
# Brute-force protection
# -----------------------------------------------------------------------------
# Set to 1 AND uncomment cap_add: NET_ADMIN in compose.mail.yaml to use it.
ENABLE_FAIL2BAN=0

# -----------------------------------------------------------------------------
# Submission hardening
# -----------------------------------------------------------------------------
# Require authentication to send mail (prevents being an open relay).
PERMIT_DOCKER=none
ONE_DIR=1
