# =============================================================================
# Simorgh AI VPS - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Domain & SSL ---
# DOMAIN must point its A/AAAA records at this server's public IP, with port 80
# reachable from the internet. The certbot service runs the HTTP-01 challenge
# and auto-renews every 12 hours.
DOMAIN=simorghai.com
CERTBOT_EMAIL=admin@simorghai.com

# --- Docker Image Registry ---
GITHUB_REPOSITORY_OWNER=shahram-tabasi
IMAGE_TAG=latest

# --- PostgreSQL Auth Database ---
POSTGRES_AUTH_USER=simorgh
POSTGRES_AUTH_PASSWORD=simorgh_secure_2024
POSTGRES_AUTH_DATABASE=simorgh_auth

# --- JWT ---
JWT_SECRET_KEY=change-me-in-production

# --- LLM Configuration ---
# For cloud-based LLM (default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEFAULT_LLM_MODE=online
# For local LLM server (optional)
LOCAL_LLM_URL=

# --- Google OAuth 2.0 (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://${DOMAIN}/chatbot/auth/google/callback

# --- Email Service (SMTP) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
FROM_EMAIL=noreply@simorgh.ai
FROM_NAME=Simorgh AI
AUTO_VERIFY_EMAIL=false

# --- Frontend URL ---
FRONTEND_URL=https://${DOMAIN}/chatbot

# --- Cookie & Security ---
SECURE_COOKIES=true
COOKIE_DOMAIN=

# --- Admin ---
ADMIN_SETUP_SECRET=

# --- Crypto Payments (optional) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

# --- Shell Service (optional, external) ---
SHELL_SERVICE_URL=
SHELL_SERVICE_TOKEN=

# --- TPMS MySQL (optional) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=TPMS

# --- TTS/STT ---
TTS_VOICE=en-US-AriaNeural
TTS_LANGUAGE=en
TTS_MAX_CACHE_MB=500
WHISPER_MODEL_SIZE=base

# --- Search ---
SEARCH_MAX_RESULTS=10

# --- Landing Page Chat Widget (uses OpenAI) ---
# Uses the same OPENAI_API_KEY from LLM Configuration above

# --- Port Configuration ---
HTTP_PORT=80
HTTPS_PORT=443
